---
/**
 * A content image (CMS path "/media/..."), resized, linking to a large version that the
 * Lightbox shows full-screen (data-srcset lets phones load the 800px variant).
 *
 * `klein` is an optional separately cropped thumbnail: the page shows it, while the
 * lightbox still enlarges `src`. Without it the thumbnail is `src` scaled down.
 */
import { Image, getImage } from 'astro:assets';
import { media } from '../lib/media';

interface Props {
	src: string;
	alt: string;
	/** Optional own crop for the thumbnail (CMS path "/media/..."). */
	klein?: string;
	/** Rendered width hint for responsive sizes, in CSS pixels. */
	width?: number;
}

const { src, alt, klein, width = 480 } = Astro.props;
const image = media(src);
const thumb = klein ? media(klein) : image;
const groot = await Promise.all(
	[...new Set([800, 1600].map((w) => Math.min(w, image.width)))].map((w) =>
		getImage({ src: image, width: w }).then((r) => ({ w, src: r.src })),
	),
);
const largest = groot[groot.length - 1].src;
const srcset = groot.map((g) => `${g.src} ${g.w}w`).join(', ');
---

<a class="foto" href={largest} data-lightbox data-srcset={srcset}>
	<Image
		src={thumb}
		alt={alt}
		widths={[...new Set([width, width * 2].map((w) => Math.min(w, thumb.width)))]}
		sizes={`(max-width: ${width + 32}px) calc(100vw - 32px), ${width}px`}
	/>
</a>

<style>
	.foto {
		display: block;
		line-height: 0;
	}
	.foto :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
	}
</style>
