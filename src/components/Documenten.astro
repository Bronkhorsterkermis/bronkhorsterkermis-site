---
import { DOC_SOORTEN, documenten } from '../lib/data';

const jaren = [...new Set(documenten.map((d) => d.jaar))].sort((a, b) => b - a);
const label = (bestand: string) => (bestand.match(/\.(\w+)$/)?.[1] ?? '').toUpperCase();
---

<div class="tabel-scroll">
	<table>
		<thead>
			<tr>
				<th>Jaar</th>
				{DOC_SOORTEN.map((s) => <th>{s}</th>)}
			</tr>
		</thead>
		<tbody>
			{
				jaren.map((jaar) => (
					<tr>
						<th scope="row">{jaar}</th>
						{DOC_SOORTEN.map((soort) => (
							<td>
								{documenten
									.filter((d) => d.jaar === jaar && d.soort === soort)
									.map((d) => (
										<a href={encodeURI(d.bestand)}>
											{d.titel ?? jaar} <span class="type">{label(d.bestand)}</span>
										</a>
									))}
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	.tabel-scroll {
		overflow-x: auto;
	}
	table {
		border-collapse: collapse;
		width: 100%;
		min-width: 36rem;
		font-size: 0.95rem;
	}
	th,
	td {
		text-align: left;
		vertical-align: top;
		padding: 0.5rem 0.75rem 0.5rem 0;
		border-bottom: 1px solid var(--line);
	}
	thead th {
		font-size: 0.85rem;
		color: var(--muted);
		font-weight: 600;
	}
	td a {
		display: block;
	}
	.type {
		font-size: 0.7rem;
		color: var(--muted);
	}
</style>
