---
import { getCollection } from 'astro:content';

const jaren = (await getCollection('documenten')).map((e) => e.data).sort((a, b) => b.jaar - a.jaar);

type Jaar = (typeof jaren)[number];
type Link = { titel: string; bestand: string };
/** The table's columns; the first three hold at most one document, the last any number. */
const kolommen: { kop: string; links: (j: Jaar) => Link[] }[] = [
	{ kop: 'Programma kermis', links: (j) => (j.programma ? [{ titel: `${j.jaar}`, bestand: j.programma }] : []) },
	{ kop: 'Uitnodiging rekening & verantwoording', links: (j) => (j.uitnodiging ? [{ titel: `${j.jaar}`, bestand: j.uitnodiging }] : []) },
	{ kop: 'Notulen rekening & verantwoording', links: (j) => (j.notulen ? [{ titel: `${j.jaar}`, bestand: j.notulen }] : []) },
	{ kop: 'Winterkostmaaltijd / overig', links: (j) => j.overig.map((o) => ({ titel: o.titel ?? `${j.jaar}`, bestand: o.bestand })) },
];
const label = (bestand: string) => (bestand.match(/\.(\w+)$/)?.[1] ?? '').toUpperCase();
---

<div class="tabel-scroll">
	<table>
		<thead>
			<tr>
				<th>Jaar</th>
				{kolommen.map((k) => <th>{k.kop}</th>)}
			</tr>
		</thead>
		<tbody>
			{
				jaren.map((j) => (
					<tr>
						<th scope="row">{j.jaar}</th>
						{kolommen.map((k) => (
							<td>
								{k.links(j).map((d) => (
									<a href={encodeURI(d.bestand)}>
										{d.titel} <span class="type">{label(d.bestand)}</span>
									</a>
								))}
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	.tabel-scroll {
		overflow-x: auto;
	}
	table {
		border-collapse: collapse;
		width: 100%;
		min-width: 36rem;
		font-size: 0.95rem;
	}
	th,
	td {
		text-align: left;
		vertical-align: top;
		padding: 0.5rem 0.75rem 0.5rem 0;
		border-bottom: 1px solid var(--line);
	}
	thead th {
		font-size: 0.85rem;
		color: var(--muted);
		font-weight: 600;
	}
	td a {
		display: block;
	}
	.type {
		font-size: 0.7rem;
		color: var(--muted);
	}
</style>
