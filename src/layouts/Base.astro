---
import { getCollection } from 'astro:content';
import { siteInfo } from '../lib/data';
import Lightbox from '../components/Lightbox.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = siteInfo.omschrijving } = Astro.props;
const pageTitle = title ? `${title} | ${siteInfo.naam}` : siteInfo.naam;

const menu = (await getCollection('pages', (p) => p.data.inMenu)).sort(
	(a, b) => a.data.volgorde - b.data.volgorde,
);
const href = (id: string) => (id === 'home' ? '/' : `/${id}`);
// With build.format 'file' the build-time path is "/activiteiten.html" (or "/index.html");
// the public URL is "/activiteiten" (or "/").
const current =
	Astro.url.pathname
		.replace(/\.html$/, '')
		.replace(/\/index$/, '')
		.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(current, Astro.site)} />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<a class="skip" href="#inhoud">Naar de inhoud</a>
		<header class="site-header">
			<div class="wrap header-inner">
				<a class="wordmark" href="/">
					<span class="wordmark-small">Schutterij</span>
					<span class="wordmark-big">Eendracht van Bronkhorst</span>
				</a>
				<button class="menu-button" type="button" aria-expanded="false" aria-controls="hoofdmenu">
					Menu
				</button>
			</div>
			<nav id="hoofdmenu" class="wrap menu" aria-label="Hoofdmenu">
				<ul>
					{
						menu.map((p) => (
							<li>
								<a href={href(p.id)} aria-current={href(p.id) === current ? 'page' : undefined}>
									{p.data.titel}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</header>
		<script>
			// Without JS the menu simply stays open; with JS it collapses behind a button on phones.
			const button = document.querySelector<HTMLButtonElement>('.menu-button')!;
			button.addEventListener('click', () => {
				const open = document.documentElement.classList.toggle('menu-open');
				button.setAttribute('aria-expanded', String(open));
			});

			// The header is sticky. On wide screens it sticks with a negative offset equal to the
			// title row, so the title scrolls away and only the menu bar stays visible. On phones the
			// title row holds the Menu button, so the whole (compact) header stays.
			const root = document.documentElement;
			const header = document.querySelector<HTMLElement>('.site-header')!;
			const titleRow = header.querySelector<HTMLElement>('.header-inner')!;
			const phone = matchMedia('(max-width: 760px)');
			const measure = () => {
				const hide = phone.matches ? 0 : titleRow.offsetHeight;
				root.style.setProperty('--sticky-top', `-${hide}px`);
				root.style.setProperty('--sticky-height', `${(phone.matches ? titleRow.offsetHeight : header.offsetHeight) - hide}px`);
			};
			new ResizeObserver(measure).observe(header);
			phone.addEventListener('change', measure);
		</script>

		<div class="wrap layout">
			<main id="inhoud">
				<slot />
			</main>
			<aside class="info">
				<h2>Contact</h2>
				<p class="pre">{siteInfo.correspondentie}</p>
				<p><a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></p>
				<h2>Bankrekening</h2>
				<p>{siteInfo.bankrekening}</p>
			</aside>
		</div>

		<Lightbox />

		<footer class="site-footer">
			<div class="wrap">© {new Date().getFullYear()} {siteInfo.naam}</div>
		</footer>
	</body>
</html>
